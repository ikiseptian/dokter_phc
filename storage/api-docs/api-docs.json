                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search support services by code or name",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Health"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
