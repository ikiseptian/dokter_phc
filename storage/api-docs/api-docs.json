        "/api/pasien": {
            "get": {
                "tags": [
                    "Pasien"
                ],
                "summary": "Ambil semua data pasien",
                "description": "Mengambil daftar semua pasien yang terdaftar. Bisa menggunakan parameter pencarian.",
                "operationId": "49dd4f9c6782abbdbf414e9da709f276",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Parameter pencarian untuk mencocokkan data pasien berdasarkan NIK, PatientID_Provider, atau kolom lain.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "John"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Daftar pasien berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Patient"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Pasien"
                ],
                "summary": "Tambah data pasien baru",
                "description": "Menambahkan pasien baru ke dalam database.",
                "operationId": "933dddcf1a6e640f74ad4a2541f1a008",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "NIK",
                                    "PatientID_Provider"
                                ],
                                "properties": {
                                    "NIK": {
                                        "type": "string",
                                        "example": "1234567890123456"
                                    },
                                    "PatientID_Provider": {
                                        "type": "string",
                                        "example": "P-001"
                                    },
                                    "FullName": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "Sex": {
                                        "type": "string",
                                        "enum": [
                                            "M",
                                            "F"
                                        ],
                                        "example": "M"
                                    },
                                    "BirthDate": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-01-01"
                                    },
                                    "Address": {
                                        "type": "string",
                                        "example": "Jl. Contoh No.1"
                                    },
                                    "Phone": {
                                        "type": "string",
                                        "example": "081234567890"
                                    },
                                    "CreateBy": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "LastModifiedBy": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "gcrecord": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pasien berhasil ditambahkan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Patient created successfully"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Patient"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request"
                    }
                }
            }
        },
        "/api/supportservice": {
            "get": {
