                    }
                },
                "responses": {
                    "201": {
                        "description": "SupportService created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportService"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
